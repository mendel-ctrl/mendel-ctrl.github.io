# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials, and never put them in the public website.
#
# CASAMBI_API_KEY  -> the X-Casambi-Key you receive from Casambi Support.
# CASAMBI_EMAIL    -> the admin email of your Casambi network (the one you use
#                     to log into the Casambi app as network admin).
# CASAMBI_PASSWORD -> that network's admin password.
# CASAMBI_NETWORK_NAME -> optional; only needed if the account has more than
#                     one network, to pick which one. Leave blank otherwise.

CASAMBI_API_KEY=
CASAMBI_EMAIL=
CASAMBI_PASSWORD=
CASAMBI_NETWORK_NAME=
